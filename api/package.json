{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:integration": "npm run db:test:migrate && NODE_ENV=test jest --runInBand --testPathIgnorePatterns=/node_modules/ --testMatch='**/test/integration/**/*.test.js'",
    "db:setup": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:test:create": "sequelize-cli db:create --env test",
    "db:test:migrate": "sequelize-cli db:migrate:undo:all --env test && sequelize-cli db:migrate --env test"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/integration/"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  }
}
