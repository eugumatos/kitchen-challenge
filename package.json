{
  "name": "kitchen-challenge",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w api\" \"npm run dev -w web\"",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration -w api",
    "db:setup": "npm run db:setup -w api",
    "db": "npm run db:setup",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
